---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  current?: "carousel";
}

const { title, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <Header current={current} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 36px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
</style>
