---
import { photographerLine, type Book } from "../lib/book";
import { coverFor, coverRatio, placeholderTone, versioned } from "../lib/cover";
import { url } from "../lib/url";

interface Props {
  book: Book;
  sizes: string;
  /** For the one big cover at the top of a page. */
  eager?: boolean;
}

const { book, sizes, eager = false } = Astro.props;
const cover = coverFor(book.slug);
const tone = placeholderTone(book);
const small = cover && url(versioned(cover, cover.src));
const large = cover && url(versioned(cover, cover.large));
const ratio = coverRatio(book.slug);
---

{cover ? (
  <div
    class="cover"
    style={`--ratio: ${ratio}; --cover-image: image-set(url("${small}") 1x, url("${large}") 2x)`}
  >
    <img
      src={small}
      srcset={`${small} 600w, ${large} 1200w`}
      sizes={sizes}
      width={cover.width}
      height={cover.height}
      alt={`Cover of ${book.title}`}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      draggable="false"
    />
  </div>
) : (
  <div
    class="cover placeholder"
    role="img"
    aria-label={`Cover placeholder for ${book.title}`}
    style={`--ratio: ${ratio}; --cover-bg: ${tone.bg}; --cover-fg: ${tone.fg}`}
  >
    <div class="cover-inner">
      <span class="cover-byline">{photographerLine(book)}</span>
      <span class="cover-title">{book.title}</span>
    </div>
  </div>
)}

<style>
  /* The parent sets the width; the height follows from --ratio. */
  .cover {
    aspect-ratio: var(--ratio);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    container-type: inline-size;
    background: var(--cover-bg);
    color: var(--cover-fg);
  }

  /* Inside the container, so cqi units scale with the cover's own width. */
  .cover-inner {
    height: 100%;
    padding: 8.5cqi;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cover-byline {
    font-size: max(11px, 3.1cqi);
  }

  .cover-title {
    font-size: 9.5cqi;
    line-height: 1.05;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
</style>
