---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  current?: "carousel" | "tile";
}

const { title, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <Header current={current} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // No right-click menu ("Save image as…") and no dragging out, on the
      // covers. Text links keep their menu.
      const isImage = (target: EventTarget | null) =>
        target instanceof Element &&
        target.closest("img, .cover, .spread-cover") !== null;
      document.addEventListener("contextmenu", (event) => {
        if (isImage(event.target)) event.preventDefault();
      });
      document.addEventListener("dragstart", (event) => {
        if (isImage(event.target)) event.preventDefault();
      });
    </script>
  </body>
</html>

<style>
  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 36px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
</style>
