// Deploys the static build in dist/ as a Cloudflare Worker with static assets.
// Without this file `wrangler deploy` tries to run `astro add cloudflare`, which fails.
{
  "name": "photobooks",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
