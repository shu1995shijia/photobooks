---
import books from "../data/books.json";
import { LOCATIONS, locationOf, type Book } from "../lib/book";
import { suggestions } from "../lib/search";
import { url } from "../lib/url";

interface Props {
  current?: "carousel" | "tile" | "daily" | "about";
}

const { current } = Astro.props;

// The listed locations, plus any a book names that isn't listed yet.
const places = [
  ...new Set([...LOCATIONS, ...(books as Book[]).map(locationOf)]),
];
// The default, showing every book.
const everywhere = "all locations";

// The shelf of every book joins this list once it's built (see tasks/todo.md).
const views = [
  { id: "carousel", label: "Carousel", href: url("carousel") },
  { id: "tile", label: "Tile", href: url("tile") },
  { id: "daily", label: "Daily", href: url("daily") },
] as const;
const currentView = views.find((view) => view.id === current);

const INSTAGRAM = "https://www.instagram.com/jimmy_novacaine/";

// What the search box offers to fill in: every title, name, publisher and so on.
const searchSuggestions = suggestions(books as Book[]);
---

<header class="header">
  <div class="title">
    <a class="site-name" href={url("")}>
      Photobooks
    </a>
    <div class="where" data-where data-everywhere={everywhere}>
      <span>A collection in</span>{" "}
      <span class="picker">
        <button
          type="button"
          class="picked"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={`Location: ${everywhere}. Choose a location`}
          data-where-button
        >
          {everywhere}
        </button>
        <ul class="menu" data-where-menu>
          <li>
            <button type="button" data-value="">
              All locations
            </button>
          </li>
          {places.map((place) => (
            <li>
              <button type="button" data-value={place}>
                {place}
              </button>
            </li>
          ))}
        </ul>
      </span>
    </div>
  </div>
  <!-- Out of sight until the pointer comes near (or it has focus, or a search). -->
  <search class="search" data-search-box>
    <label class="visually-hidden" for="book-search">
      Search the books
    </label>
    <div class="search-field">
      <input
        id="book-search"
        type="search"
        placeholder="Search"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="search-suggestions"
        data-search-input
        data-results={url("tile")}
      />
      <ul
        id="search-suggestions"
        class="suggestions"
        role="listbox"
        aria-label="Suggestions"
        hidden
        data-suggestions
      ></ul>
    </div>
    <script
      type="application/json"
      id="search-suggestions-data"
      set:html={JSON.stringify(searchSuggestions).replace(/</g, "\\u003c")}
    />
  </search>
  <nav aria-label="Site">
    <button type="button" class="view-link shuffle" hidden data-shuffle>
      Shuffle
    </button>
    <button type="button" class="view-link shuffle" hidden data-pick>
      Pick for me
    </button>
    <div class="views" data-views>
      <button
        type="button"
        class="view-link views-button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={`View: ${currentView?.label ?? "none"}. Choose a view`}
        data-views-button
      >
        {currentView?.label ?? "Views"}
      </button>
      <ul class="views-menu">
        {views.map((view) => (
          <li>
            <a
              href={view.href}
              aria-current={view.id === current ? "page" : undefined}
            >
              {view.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a
      class="view-link"
      href={url("about")}
      aria-current={current === "about" ? "page" : undefined}
    >
      About
    </a>
    <a
      class="view-link instagram"
      href={INSTAGRAM}
      rel="me noopener"
      target="_blank"
      aria-label="Instagram"
      title="Instagram"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <circle
          cx="12"
          cy="12"
          r="4.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" />
      </svg>
    </a>
  </nav>
</header>

<script>
  import { initShuffle } from "../scripts/shuffle";

  initShuffle();
</script>

<script>
  // A tap (no hover on a phone) opens and closes the views menu.
  for (const views of document.querySelectorAll<HTMLElement>("[data-views]")) {
    const button = views.querySelector<HTMLButtonElement>(
      "[data-views-button]",
    )!;
    const open = (yes: boolean) =>
      button.setAttribute("aria-expanded", String(yes));
    button.addEventListener("click", () =>
      open(button.getAttribute("aria-expanded") !== "true"),
    );
    views.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        open(false);
        button.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (!views.contains(event.target as Node)) open(false);
    });
  }
</script>

<script>
  import {
    chooseLocation,
    chosenLocation,
    onLocation,
  } from "../scripts/location";

  for (const where of document.querySelectorAll<HTMLElement>("[data-where]")) {
    const button = where.querySelector<HTMLButtonElement>(
      "[data-where-button]",
    )!;
    const options = [
      ...where.querySelectorAll<HTMLButtonElement>("[data-value]"),
    ];
    const known = options.map((o) => o.dataset.value!).filter(Boolean);
    const everywhere = where.dataset.everywhere!;

    const show = (location: string | null) => {
      button.textContent = location ?? everywhere;
      button.setAttribute(
        "aria-label",
        `Location: ${location ?? everywhere}. Choose a location`,
      );
      for (const option of options)
        option.toggleAttribute(
          "data-chosen",
          (option.dataset.value || null) === location,
        );
    };
    const open = (yes: boolean) =>
      button.setAttribute("aria-expanded", String(yes));

    // A tap (no hover on a phone) or Enter/Space opens and closes the menu.
    button.addEventListener("click", () =>
      open(button.getAttribute("aria-expanded") !== "true"),
    );
    for (const option of options)
      option.addEventListener("click", () => {
        chooseLocation(option.dataset.value || null);
        open(false);
        button.focus();
      });
    where.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        open(false);
        button.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (!where.contains(event.target as Node)) open(false);
    });

    onLocation(show);
    show(chosenLocation(known));
    where.classList.add("is-enhanced");
  }
</script>

<script>
  import { suggest, type Suggestion } from "../lib/search";
  import { currentSearch, setSearch } from "../scripts/search";

  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const list = document.querySelector<HTMLElement>("[data-suggestions]");
  if (input && list) {
    const all: Suggestion[] = JSON.parse(
      document.getElementById("search-suggestions-data")?.textContent ?? "[]",
    );
    let options: HTMLElement[] = [];
    let active = -1;

    const open = (yes: boolean) => {
      list.hidden = !yes || options.length === 0;
      input.setAttribute("aria-expanded", String(!list.hidden));
    };

    /** Highlights option `i` (none when -1) and keeps it in view. */
    const highlight = (i: number) => {
      options[active]?.removeAttribute("aria-selected");
      active = i;
      const option = options[active];
      if (option) {
        option.setAttribute("aria-selected", "true");
        option.scrollIntoView({ block: "nearest" });
        input.setAttribute("aria-activedescendant", option.id);
      } else input.removeAttribute("aria-activedescendant");
    };

    /** Lists the suggestions matching what's typed, under a heading for each kind. */
    const fill = () => {
      const items: HTMLElement[] = [];
      options = [];
      active = -1;
      input.removeAttribute("aria-activedescendant");
      let kind = "";
      for (const s of suggest(all, input.value)) {
        if (s.kind !== kind) {
          kind = s.kind;
          const heading = document.createElement("li");
          heading.className = "kind";
          heading.setAttribute("role", "presentation");
          heading.textContent = kind;
          items.push(heading);
        }
        const option = document.createElement("li");
        option.id = `suggestion-${options.length}`;
        option.setAttribute("role", "option");
        option.dataset.value = s.value;
        const count = document.createElement("span");
        count.className = "count";
        count.textContent = String(s.count);
        option.append(s.value, count);
        options.push(option);
        items.push(option);
      }
      list.replaceChildren(...items);
      list.scrollTop = 0;
    };

    /** Leaves the box; on a page without a list of books (a book's own page), searches in the tile view. */
    const done = () => {
      open(false);
      if (
        input.value &&
        !document.querySelector("[data-location][data-search]")
      )
        location.href = input.dataset.results!;
      input.blur();
    };

    const pick = (value: string) => {
      input.value = value;
      setSearch(value);
      done();
    };

    input.value = currentSearch();
    input.addEventListener("focus", () => {
      fill();
      open(true);
    });
    input.addEventListener("blur", () => open(false));
    input.addEventListener("input", () => {
      setSearch(input.value.trim());
      fill();
      open(true);
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        if (list.hidden) open(true);
        const step = event.key === "ArrowDown" ? 1 : -1;
        highlight(Math.max(-1, Math.min(options.length - 1, active + step)));
      } else if (event.key === "Enter") {
        // Enter fills in the highlighted suggestion, or keeps what's typed;
        // either way it's spent here, so it doesn't also open a book.
        event.preventDefault();
        event.stopPropagation();
        const option = options[active];
        if (option && !list.hidden) pick(option.dataset.value!);
        else done();
      } else if (event.key === "Escape") {
        // Esc closes the suggestions first, then clears the search.
        event.preventDefault();
        if (!list.hidden) return open(false);
        input.value = "";
        setSearch("");
        input.blur();
      }
    });
    // Pressing on a suggestion mustn't blur the box before the click lands.
    list.addEventListener("mousedown", (event) => event.preventDefault());
    list.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLElement>(
        "[role=option]",
      );
      if (option) pick(option.dataset.value!);
    });
    list.addEventListener("mousemove", (event) => {
      const option = (event.target as Element).closest<HTMLElement>(
        "[role=option]",
      );
      if (option && options.indexOf(option) !== active)
        highlight(options.indexOf(option));
    });
    // "/" jumps to the search from anywhere but a field or an open book.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey)
        return;
      if (document.querySelector("dialog[open]")) return;
      const focused = document.activeElement;
      if (focused?.closest("input, select, textarea, [contenteditable]"))
        return;
      event.preventDefault();
      input.focus();
    });
  }
</script>

<style is:global>
  /* The cover the Shuffle highlight is on. */
  a.is-shuffle-pick .cover {
    outline: 4px solid var(--red-dot);
    outline-offset: -4px;
  }
</style>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  /* Title, search and links in three columns, so the search sits in the page's middle. */
  @media (min-width: 721px) {
    .header {
      display: grid;
      grid-template-columns: 1fr minmax(160px, 360px) 1fr;
    }

    nav {
      justify-self: end;
    }
  }

  /* The whole middle of the header is the hover target. */
  .search {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
  }

  .search-field {
    position: relative;
    width: 100%;
  }

  .search input {
    width: 100%;
    min-height: 36px;
    padding: 0 2px;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--shelf);
    border-radius: 0;
    outline: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .search input::placeholder {
    color: var(--graphite);
  }

  .search input:focus {
    border-bottom-color: var(--ink);
  }

  .search:hover input,
  .search input:focus,
  .search input:not(:placeholder-shown) {
    opacity: 1;
  }

  .suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    max-height: min(420px, 60vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: var(--wall);
    border: 1px solid var(--shelf);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
  }

  .suggestions[hidden] {
    display: none;
  }

  .suggestions :global(.kind) {
    padding: 10px 12px 4px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .suggestions :global([role="option"]) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 7px 12px;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
  }

  .suggestions :global([aria-selected="true"]) {
    background: rgb(0 0 0 / 0.05);
  }

  .suggestions :global(.count) {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }

  /* Without hover (a phone), it stays in sight, quietly. */
  @media (hover: none) {
    .search input {
      opacity: 1;
    }
  }

  /* On a narrow screen it takes its own row under the title. */
  @media (max-width: 720px) {
    .search {
      order: 3;
      flex-basis: 100%;
    }

    .search input {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search input {
      transition: none;
    }
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .where {
    font-size: 13px;
    color: var(--graphite);
  }

  .picker {
    position: relative;
    display: inline-block;
  }

  /* Reads as plain text until the menu opens. */
  .picked {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: default;
  }

  .where.is-enhanced .picked {
    cursor: pointer;
  }

  .menu {
    display: none;
    position: absolute;
    top: 100%;
    left: -12px;
    z-index: 10;
    min-width: 200px;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: var(--wall);
    border: 1px solid var(--shelf);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
  }

  /* Only on hover (or keyboard focus, or a tap), and only when it works. */
  .where.is-enhanced .picker:hover .menu,
  .where.is-enhanced .picker:focus-within .menu,
  .where.is-enhanced .picked[aria-expanded="true"] + .menu {
    display: block;
  }

  .where.is-enhanced .picker:hover .picked,
  .where.is-enhanced .picker:focus-within .picked {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .menu button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 36px;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu button:hover,
  .menu button:focus-visible {
    background: rgb(0 0 0 / 0.04);
  }

  /* The gallery red dot marks the chosen location. */
  .menu button::before {
    content: "";
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .menu button[data-chosen]::before {
    background: var(--red-dot);
  }

  .site-name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 4px;
  }

  .view-link {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    color: var(--graphite);
    text-decoration: none;
  }

  .view-link:hover {
    color: var(--ink);
  }

  /* The gallery red dot marks the page you're on (About). */
  a.view-link[aria-current="page"] {
    color: var(--ink);
  }

  a.view-link[aria-current="page"]::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red-dot);
  }

  .shuffle {
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .shuffle[hidden] {
    display: none;
  }

  .shuffle[aria-busy="true"] {
    color: var(--ink);
  }

  /* While shuffling, the gallery red dot runs ahead of the book being picked. */
  .shuffle[aria-busy="true"]::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red-dot);
  }

  .views {
    position: relative;
  }

  .views-button {
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
  }

  .views-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 10;
    min-width: 160px;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: var(--wall);
    border: 1px solid var(--shelf);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
  }

  /* Opens on hover or keyboard focus (no script needed), or on a tap. */
  .views:hover .views-menu,
  .views:focus-within .views-menu,
  .views-button[aria-expanded="true"] + .views-menu {
    display: block;
  }

  .views:hover .views-button,
  .views:focus-within .views-button {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .views-menu a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
  }

  .views-menu a:hover,
  .views-menu a:focus-visible {
    background: rgb(0 0 0 / 0.04);
  }

  /* The gallery red dot marks the view you're on. */
  .views-menu a::before {
    content: "";
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .views-menu a[aria-current="page"]::before {
    background: var(--red-dot);
  }
</style>
