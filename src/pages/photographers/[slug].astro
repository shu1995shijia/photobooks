---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import BookPopup from "../../components/BookPopup.astro";
import Shelf from "../../components/Shelf.astro";
import books from "../../data/books.json";
import type { Book } from "../../lib/book";
import { photographers, type Photographer } from "../../lib/photographer";

export const getStaticPaths = (() =>
  photographers(books as Book[]).map((photographer) => ({
    params: { slug: photographer.slug },
    props: { photographer },
  }))) satisfies GetStaticPaths;

interface Props {
  photographer: Photographer;
}

const { photographer } = Astro.props;
const count = photographer.books.length;
---

<Base title={`${photographer.name}: Photobooks`}>
  <section class="photographer">
    <div class="heading">
      <h1>{photographer.name}</h1>
      <p class="count">
        {count === 1 ? "One book" : `${count} books`} in the collection
      </p>
    </div>

    <Shelf books={photographer.books} />
  </section>
  <BookPopup />
</Base>

<style>
  .photographer {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  h1 {
    margin: 0;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .count {
    margin: 6px 0 0;
    color: var(--graphite);
  }
</style>
